# ═══════════════════════════════════════════
#  CEBE-Portal — .gitignore unificado
#  Cobre: Node.js (client) + Java/Maven (server)
# ═══════════════════════════════════════════

# ── Node.js / Front-end ─────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Variáveis de ambiente ────────────────────
.env
.env.local
.env.*.local

# ── Build / Dist ─────────────────────────────
dist/

# ── Java / Maven ─────────────────────────────
HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── Spring Boot ──────────────────────────────
application-local.properties
application-local.yml

# ── IDEs ─────────────────────────────────────
# VS Code
.vscode/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln

# macOS
.DS_Store

# Windows
Thumbs.db
